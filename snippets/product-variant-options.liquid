{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
  %}
{% endcomment %}
{%- liquid
  assign variants_available_arr = product.variants | map: 'available'
  assign variants_option1_arr = product.variants | map: 'option1'
  assign variants_option2_arr = product.variants | map: 'option2'
  assign variants_option3_arr = product.variants | map: 'option3'

  assign product_form_id = 'product-form-' | append: section.id
  
  # Check if this is a Color option (case-insensitive)
  assign is_color_option = false
  assign option_name_lower = option.name | downcase
  if option_name_lower == 'color' or option_name_lower == 'colour'
    assign is_color_option = true
  endif
-%}

{%- for value in option.values -%}
  {%- liquid
    assign option_disabled = true
    assign variant_with_value = null
    assign color_swatch_value = null
    assign color_swatch_name = value

    for option1_name in variants_option1_arr
      case option.position
        when 1
          if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
            assign variant_with_value = product.variants[forloop.index0]
          endif
        when 2
          if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
            assign variant_with_value = product.variants[forloop.index0]
          endif
        when 3
          if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
            assign option_disabled = false
            assign variant_with_value = product.variants[forloop.index0]
          endif
      endcase
    endfor

    # Try to get color swatch information from variant metafields
    # For Product Taxonomy, we need to check ALL variants with this color value
    # to find the one with the swatch data
    if is_color_option
      # First, try to get from the matched variant
      if variant_with_value != null
        # Check for Shopify Product Taxonomy color swatch metafields
        # Try multiple possible metafield paths
        if variant_with_value.metafields.shopify.color != blank
          assign color_swatch_value = variant_with_value.metafields.shopify.color
        elsif variant_with_value.metafields.shopify.color_swatch != blank
          assign color_swatch_value = variant_with_value.metafields.shopify.color_swatch
        elsif variant_with_value.metafields.custom.color_swatch != blank
          assign color_swatch_value = variant_with_value.metafields.custom.color_swatch
        elsif variant_with_value.metafields.custom.color != blank
          assign color_swatch_value = variant_with_value.metafields.custom.color
        endif
      endif
      
      # If not found, check ALL variants with this color value
      if color_swatch_value == blank
        for variant in product.variants
          # Check if this variant has the color value we're looking for
          assign variant_has_color = false
          if option.position == 1 and variant.option1 == value
            assign variant_has_color = true
          elsif option.position == 2 and variant.option2 == value
            assign variant_has_color = true
          elsif option.position == 3 and variant.option3 == value
            assign variant_has_color = true
          endif
          
          if variant_has_color
            # Try all metafield paths
            if variant.metafields.shopify.color != blank
              assign color_swatch_value = variant.metafields.shopify.color
              break
            elsif variant.metafields.shopify.color_swatch != blank
              assign color_swatch_value = variant.metafields.shopify.color_swatch
              break
            elsif variant.metafields.custom.color_swatch != blank
              assign color_swatch_value = variant.metafields.custom.color_swatch
              break
            elsif variant.metafields.custom.color != blank
              assign color_swatch_value = variant.metafields.custom.color
              break
            endif
          endif
        endfor
      endif
      
      # Extract hex color from the metafield value
      if color_swatch_value != blank
        # Product Taxonomy color swatch is typically an object with a 'value' property
        # Try to access the value property first (most common structure)
        if color_swatch_value.value != blank
          assign color_hex = color_swatch_value.value
        # Try 'color' property as alternative
        elsif color_swatch_value.color != blank
          assign color_hex = color_swatch_value.color
        # Check if it's already a hex color string
        elsif color_swatch_value contains '#'
          assign color_parts = color_swatch_value | split: '#'
          if color_parts.size > 1
            assign color_hex = '#' | append: color_parts[1] | split: ' ' | first | split: ',' | first | split: ';' | first | split: '"' | first
          else
            assign color_hex = color_swatch_value
          endif
        # Try to use the value directly (might be a string)
        else
          assign color_hex = color_swatch_value
        endif
        
        # Ensure we have a valid hex color (starts with #)
        unless color_hex contains '#'
          # Remove any whitespace and ensure it's a valid hex
          assign color_hex_clean = color_hex | strip
          if color_hex_clean != blank
            assign color_hex = '#' | append: color_hex_clean
          endif
        endunless
      else
        # Fallback: Try to get color from a color mapping for common colors
        # Only use this if we couldn't find any metafield data
        assign color_name_lower = value | downcase | strip
        case color_name_lower
          when 'black'
            assign color_hex = '#000000'
          when 'white'
            assign color_hex = '#FFFFFF'
          when 'red'
            assign color_hex = '#FF0000'
          when 'blue'
            assign color_hex = '#0000FF'
          when 'green'
            assign color_hex = '#008000'
          when 'yellow'
            assign color_hex = '#FFFF00'
          when 'ocean blue'
            assign color_hex = '#03E8FF'
          when 'beige'
            assign color_hex = '#F5F5DC'
          when 'bronze'
            assign color_hex = '#CD7F32'
        endcase
      endif
    endif
  -%}

  {%- if block.settings.picker_type == 'button' -%}
    <input
      type="radio"
      id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
      name="{{ option.name }}"
      value="{{ value | escape }}"
      form="{{ product_form_id }}"
      {% if option.selected_value == value %}
        checked
      {% endif %}
      {% if option_disabled %}
        class="disabled"
      {% endif %}
      {% if is_color_option and color_hex != blank %}
        data-color-swatch="{{ color_hex }}"
        data-color-name="{{ color_swatch_name }}"
      {% endif %}
    >
    <label 
      for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
      {% if is_color_option and color_hex != blank %}class="color-swatch-label"{% endif %}
    >
      {%- if is_color_option and color_hex != blank -%}
        <span class="color-swatch" style="background-color: {{ color_hex }};" aria-label="{{ color_swatch_name }}"></span>
        <span class="color-swatch-text">{{ color_swatch_name }}</span>
        <span class="visually-hidden">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
      {%- else -%}
        {{ value -}}
        <span class="visually-hidden">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
      {%- endif -%}
    </label>
  {%- elsif block.settings.picker_type == 'dropdown' -%}
    <option
      value="{{ value | escape }}"
      {% if option.selected_value == value %}
        selected="selected"
      {% endif %}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>
  {%- endif -%}
{%- endfor -%}
